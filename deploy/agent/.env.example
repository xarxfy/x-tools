# Address of your X-TOOLS instance and the agent key (shown once when you
# create the agent under Settings → Agents).
XT_AGENT_URL=https://tools.example.com
XT_AGENT_KEY=

# Optional: Cloudflare Access service token, if X-TOOLS is behind Cloudflare
# Access (add an Access rule "Service Auth" for /api/agent/).
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# Folders in which compose projects may live on this server.
XT_COMPOSE_ROOTS=/opt,/srv,/home,/root
XT_TIMEZONE=Europe/Berlin

# Optional: Proxmox (API token with role PVEAuditor, read-only).
# PROXMOX_URL=https://127.0.0.1:8006
# PROXMOX_TOKEN_ID=xtools@pve!agent
# PROXMOX_TOKEN_SECRET=
# PROXMOX_VERIFY_TLS=0
