# Public address of X-TOOLS. Used for links in notifications; with https://
# session cookies are marked Secure.
XT_BASE_URL=https://tools.example.com

# Time zone for displayed times (IANA name).
XT_TIMEZONE=Europe/Berlin

# Folders (comma-separated) in which docker compose projects may live.
# The collector only reads compose files and Dockerfiles below these.
# /home, /opt and /srv are mounted into the collector (docker-compose.yml);
# add a volume there if your projects live somewhere else.
XT_COMPOSE_ROOTS=/opt,/srv,/home

# Optional: home folder shown as "~" in paths, e.g. /home/alice
XT_HOME_DIR=

# Address the web UI listens on (host network). Keep 127.0.0.1 behind a
# reverse proxy or tunnel on the same machine.
XT_HOST=127.0.0.1
XT_PORT=8080

# Containers that cannot be stopped from the UI.
XT_PROTECTED_CONTAINERS=x-tools,x-tools-collector

# Trust X-Forwarded-For/-Proto from the reverse proxy in front of X-TOOLS.
XT_TRUST_PROXY=true

# Optional: fixed secret key (Fernet). Leave empty to have one generated in
# the data volume on first start. Losing it makes stored credentials unreadable.
XT_SECRET_KEY=

# Optional: interactive API docs at /api/docs (development).
XT_API_DOCS=false
